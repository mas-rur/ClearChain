{
  "name": "clearchain",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous on-chain payment verification & escrow agent for BNB Chain",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network bscMainnet",
    "authorize:testnet": "hardhat run scripts/authorizeAgent.js --network bscTestnet",
    "agent": "node agent/matcher.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "ethers": "^6.13.0",
    "dotenv": "^16.4.0"
  }
}
